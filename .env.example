# AmazonHelp AI Support Agent — Environment Configuration Example
# Copy this file to .env and provide your deployment credentials.
# Note: The agent operates in 100% offline deterministic mode without external API keys.

# Optional LLM Provider Settings (for future generative extensions)
LLM_PROVIDER=offline_fallback
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Support Agent Configuration
AGENT_ENVIRONMENT=production
AGENT_CONFIDENCE_THRESHOLD=0.60
AGENT_MAX_RETRIEVAL_RESULTS=3
AGENT_ESCALATION_ENABLED=true
